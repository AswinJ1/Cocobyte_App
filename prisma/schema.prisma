generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DIRECT_URL")
}

model User {
  id                    String         @id @default(cuid())
  email                 String         @unique
  uid                   String?        @unique
  password              String
  role                  Role
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  admin                 Admin?
  loginLogs             LoginLog[]
  participant           Participant?
  notifications         Notification[] @relation("UserNotifications")
  createdNotifications  Notification[] @relation("CreatedNotifications")
  
  @@index([email])
  @@index([uid])
}

model Admin {
  id        String   @id @default(cuid())
  userId    String   @unique
  name      String
  createdAt DateTime @default(now())
  isSuperAdmin Boolean @default(false)  
  updatedAt DateTime @updatedAt
  avatarUrl String?
  gender    String   @default("male")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Participant {
  id             String   @id @default(cuid())
  userId         String   @unique
  name           String
  college        String
  teamName       String?
  siteName       String?
  hostelName     String?
  wifiusername   String?
  wifiPassword   String?
  hostelLocation String?
  contactNumber  String?
  roomNumber     String? 
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  avatarUrl      String?
  gender         String   @default("male")
  isCheckedIn    Boolean  @default(false)
  checkInTime    DateTime?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location       UserLocation?
  
  // Arrival Details
  transportMode           TransportMode?
  arrivalFrom             String?
  arrivalTo               String?
  carpoolContactNumber    String?
  expectedArrivalTime     DateTime?
  interestedInCarpool     Boolean?  @default(false)
  arrivalDetailsSubmitted Boolean?  @default(false)
  
  // Carpool Interests - received from others
  carpoolInterestsReceived CarpoolInterest[] @relation("ArrivalOwner")
  // Carpool Interests - sent to others
  carpoolInterestsSent     CarpoolInterest[] @relation("InterestedParticipant")
}

model LoginLog {
  id         String   @id @default(cuid())
  userId     String?
  email      String
  ipAddress  String
  userAgent  String
  deviceType String?
  os         String?
  browser    String?
  city       String?
  region     String?
  country    String?
  latitude   Float?
  longitude  Float?
  isSuccess  Boolean  @default(true)
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([createdAt])
  @@index([userId])
  @@index([ipAddress])
}

model Notification {
  id         String               @id @default(cuid())
  userId     String?
  user       User?                @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  title      String
  message    String
  type       NotificationType     @default(INFO)
  priority   NotificationPriority @default(NORMAL)
  targetRole Role?
  targetSite  String?  // Amritapuri, Mysuru, Coimbatore, Bangalore, or null for all
  actionUrl  String?
  isRead     Boolean              @default(false)
  readAt     DateTime?
  expiresAt  DateTime?
  createdBy  String
  creator    User                 @relation("CreatedNotifications", fields: [createdBy], references: [id], onDelete: Cascade)
  createdAt  DateTime             @default(now())
  
  @@index([userId])
  @@index([createdAt])
  @@index([isRead])
  @@index([targetRole])
}

model UserLocation {
  id           String   @id @default(cuid())
  participantId String  @unique
  participant  Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  latitude     Float
  longitude    Float
  siteName     String
  updatedAt    DateTime @updatedAt
  isActive     Boolean  @default(true)

  @@index([siteName])
  @@index([isActive])
}

model CarpoolInterest {
  id                    String      @id @default(cuid())
  
  // The participant who submitted arrival details (receives the interest)
  arrivalOwnerId        String
  arrivalOwner          Participant @relation("ArrivalOwner", fields: [arrivalOwnerId], references: [id], onDelete: Cascade)
  
  // The participant who is interested in carpooling
  interestedParticipantId String
  interestedParticipant   Participant @relation("InterestedParticipant", fields: [interestedParticipantId], references: [id], onDelete: Cascade)
  
  // Contact number of the interested participant
  contactNumber         String
  message               String?     // Optional message
  
  createdAt             DateTime    @default(now())
  
  @@unique([arrivalOwnerId, interestedParticipantId])
  @@index([arrivalOwnerId])
  @@index([interestedParticipantId])
}

enum Role {
  ADMIN
  PARTICIPANT
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  ANNOUNCEMENT
  CONTEST
  SYSTEM
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}
enum TransportMode {
  FLIGHT
  TRAIN
  BUS
  OTHER
}